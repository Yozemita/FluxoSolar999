# Set these in Railway Variables, never commit actual credential values.
ADMIN_USERNAME=rapha
ADMIN_PASSWORD=CHANGE_ME_WITH_16_OR_MORE_CHARACTERS
# Railway: use the private PostgreSQL service reference, e.g. ${{Postgres.DATABASE_URL}}
# DATABASE_URL=
# For local development only, without DATABASE_URL the app uses data/growth.db.
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Optional integrations; never expose their internal endpoints to browsers.
# REDIS_URL=
# S3_BUCKET=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
